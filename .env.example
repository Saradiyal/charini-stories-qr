# CHARINI Stories - Environment Variables
# Copy this file to .env.local and update with your Supabase project credentials.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (NEVER expose to browser/client - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Supabase Anon Key (for public client operations if needed)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Brand Channels (leave empty to use default config in lib/config/constants.ts)
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/charinistories
# NEXT_PUBLIC_WEBSITE_URL=https://charinistories.com
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/1234567890
# NEXT_PUBLIC_CONTACT_URL=mailto:hello@charinistories.com
